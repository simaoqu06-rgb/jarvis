# Copie ce fichier en .env (jamais commité) et remplis les valeurs.
# Les sources sans clé fonctionnent sans rien remplir.

# Bourse de New York (principale) : https://twelvedata.com/register
TWELVEDATA_API_KEY=
# Appels Twelve Data par minute (8 en gratuit ; à relever avec un plan payant)
TWELVEDATA_CREDITS_PER_MINUTE=8
# Bourse (secours) + actus générales et par société : https://finnhub.io/register
FINNHUB_API_KEY=

# User-Agent envoyé à toutes les API (Nominatim, MET Norway et Wikipédia exigent qu'il identifie l'application)
JARVIS_USER_AGENT=JARVIS-personal/0.1 (+https://github.com/simaoqu06-rgb/jarvis)
# Fichier où est gardée la dernière valeur connue de chaque donnée
JARVIS_LAST_KNOWN_PATH=data/last_known.json

# Notifications Discord : URL du webhook du salon (Paramètres du salon > Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=
# Mettre « off » pour couper les envois sans retirer le webhook
JARVIS_NOTIFICATIONS=on
# Valeurs suivies (alertes de variation et point du matin)
JARVIS_WATCHLIST_CRYPTO=BTC,ETH
JARVIS_WATCHLIST_STOCKS=
# Alerte à chaque palier de variation (5 = à ±5 %, ±10 %…) : sur 24 h pour les cryptos, sur la séance pour les actions
JARVIS_MOVE_ALERT_PCT=5
# Séismes signalés à partir de cette magnitude
JARVIS_QUAKE_MIN_MAGNITUDE=6
# Alerte Discord quand le disque du serveur dépasse ce taux (en %), « critique » au-dessus de 90 %
JARVIS_DISK_ALERT_PCT=75
# Ville pour la météo et l'air dans le point du matin (vide = pas de météo)
JARVIS_CITY=Lyon
JARVIS_ALERTS_STATE_PATH=data/alerts_state.json
JARVIS_TRADES_PATH=data/trades.json
# Trading : capital du compte EN EUROS (pour la taille de position). Une seule règle de taille : risque par trade
# = min(capital × % proposé par le grade, JARVIS_RISK_EUR), converti en $ au change BCE du jour ; capital vide :
# JARVIS_RISK_EUR dès que le grade propose plus de 0 %. Grade à 0 % : pas de taille de JARVIS, ta règle à part.
JARVIS_CAPITAL=
# Risque maximal par trade en euros (ta règle ; aussi la taille de Killmode, des GO confirmés et du potentiel +10)
JARVIS_RISK_EUR=20
# Risque par défaut du labo seulement, en % (en direct, c'est le grade qui propose)
JARVIS_RISK_PCT=3
# Grade du labo plus vieux que ça (heures depuis son dernier passage réussi) : périmé, risque proposé 0 %
JARVIS_GRADE_MAX_AGE_H=6
# Message « cockpit » sur Discord, réécrit chaque minute (off pour le couper)
JARVIS_DISCORD_COCKPIT=on

# Alpaca (compte fictif « paper ») : scanner pré-ouverture et forward-test. https://app.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Garde-fou : JARVIS refuse de trader si ce n'est pas true (jamais d'ordre réel)
ALPACA_PAPER=true
JARVIS_SCANS_PATH=data/scans.jsonl
JARVIS_PAPER_PATH=data/paper.json
# Seuils de la note, du veto et du scanner, et propositions de réglages de JARVIS
JARVIS_SETTINGS_PATH=data/trading_settings.json
JARVIS_PROPOSALS_PATH=data/trading_proposals.json
# Messages Discord en attente d'envoi (renvoyés jusqu'à réussite)
JARVIS_OUTBOX_PATH=data/outbox.json
# Secondes entre deux vérifications des trades sur actions (en séance)
JARVIS_STOCK_CHECK_SECONDS=110
# Fermetures exceptionnelles de la Bourse de New York, dates AAAA-MM-JJ séparées par des virgules
JARVIS_NYSE_EXTRA_CLOSED=
# Origines autorisées à modifier JARVIS en plus de l'adresse du cockpit (rarement utile)
JARVIS_ALLOWED_ORIGINS=

# Bot Discord pour les commandes (!plan, !prends, !scan, !bilan, !propositions, !oui, !non, !regle, !aide)
# et le ou les comptes autorisés (identifiants séparés par des virgules)
DISCORD_BOT_TOKEN=
JARVIS_DISCORD_OWNER_ID=
# Copie en message privé des alertes des trades suivis (TP, stop, sortie anticipée, conseil avant la clôture)
JARVIS_TRADE_DM=on

# Labo de performance (service jarvis-lab) : trades simulés avec le code du direct, journal SQLite
JARVIS_LAB_ENABLED=on
JARVIS_LAB_DB=data/lab.db
# Séances rejouées avant le premier lancement du labo (504 ≈ 2 ans)
JARVIS_LAB_REPLAY_DAYS=504
# Requêtes Alpaca par minute pour le labo (la limite gratuite de 200 est partagée avec JARVIS en direct)
JARVIS_LAB_ALPACA_PER_MINUTE=100
# Appels Finnhub par minute pour les fiches catalyseurs du labo (utilise FINNHUB_API_KEY)
JARVIS_LAB_FINNHUB_PER_MINUTE=20
# Appels Finnhub par minute de l'archive des actus des gappers (n° 8), hors séance US ; le direct garde le reste des 60
JARVIS_LAB_ARCHIVE_PER_MINUTE=30
# Clé des routes /api/lab/* (brief, résumé, stats, fiches, règles, types) pour la routine du soir ; vide = désactivées
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_LAB_API_KEY=
# Message privé du matin du labo (8 h - 9 h, règles validées à approuver) : off = rodage (gardé, pas envoyé)
JARVIS_LAB_DM=off
# État du message du matin (un par jour, jamais deux)
JARVIS_LAB_MORNING_PATH=data/lab_morning.json
# Méthode en place écrite par le worker et lue par JARVIS en direct (vide = data/lab_champion.json)
JARVIS_LAB_CHAMPION=
