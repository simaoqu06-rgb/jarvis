# Copie ce fichier en .env (jamais commité) et remplis les valeurs.
# Les sources sans clé fonctionnent sans rien remplir.

# Bourse de New York (principale) : https://twelvedata.com/register
TWELVEDATA_API_KEY=
# Bourse (secours) + actus générales et par société : https://finnhub.io/register
FINNHUB_API_KEY=

# User-Agent envoyé à toutes les API (Nominatim, MET Norway et Wikipédia exigent qu'il identifie l'application)
JARVIS_USER_AGENT=JARVIS-personal/0.1 (+https://github.com/simaoqu06-rgb/jarvis)
# Fichier où est gardée la dernière valeur connue de chaque donnée
JARVIS_LAST_KNOWN_PATH=data/last_known.json

# Notifications Discord : URL du webhook du salon (Paramètres du salon > Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=
# Mettre « off » pour couper les envois sans retirer le webhook
JARVIS_NOTIFICATIONS=on
# Valeurs suivies (alertes de variation et point du matin)
JARVIS_WATCHLIST_CRYPTO=BTC,ETH
JARVIS_WATCHLIST_STOCKS=
# Alerte à chaque palier de variation sur la journée (5 = à ±5 %, ±10 %…)
JARVIS_MOVE_ALERT_PCT=5
# Séismes signalés à partir de cette magnitude
JARVIS_QUAKE_MIN_MAGNITUDE=6
# Ville pour la météo et l'air dans le point du matin (vide = pas de météo)
JARVIS_CITY=Lyon
JARVIS_ALERTS_STATE_PATH=data/alerts_state.json
JARVIS_TRADES_PATH=data/trades.json
# Trading : capital (pour la taille de position) et risque par trade en % (EmperorBTC : 3, agressif : 5)
JARVIS_CAPITAL=
JARVIS_RISK_PCT=3
# Message « cockpit » sur Discord, réécrit chaque minute (off pour le couper)
JARVIS_DISCORD_COCKPIT=on

# Alpaca (compte fictif « paper ») : scanner pré-ouverture et forward-test. https://app.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Garde-fou : JARVIS refuse de trader si ce n'est pas true (jamais d'ordre réel)
ALPACA_PAPER=true
JARVIS_SCANS_PATH=data/scans.jsonl
JARVIS_PAPER_PATH=data/paper.json
# Seuils de la note, du veto et du scanner modifiés par !regle ou PUT /api/trading/settings
JARVIS_SETTINGS_PATH=data/trading_settings.json

# Bot Discord pour les commandes (!plan, !prends, !scan, !bilan, !regle) et le compte autorisé
DISCORD_BOT_TOKEN=
JARVIS_DISCORD_OWNER_ID=
